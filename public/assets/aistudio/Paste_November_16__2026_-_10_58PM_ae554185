            const formattedDate = dateObj.toLocaleDateString('en-GB', {
                weekday: 'short',
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });

            // Generate random reference code
            const randomCode = Math.floor(1000 + Math.random() * 9000);
            const refCode = `CL49-${randomCode}`;
            document.getElementById('booking-ref').textContent = `REF: #${refCode}`;

            // Render summary cards
            const summaryContainer = document.getElementById('summary-details');
            summaryContainer.innerHTML = `
                <div class="p-3.5 rounded-xl bg-charcoal border border-white/5">
                    <span class="text-[10px] uppercase tracking-widest text-silverMuted block">Guest Name</span>
                    <span class="text-alabaster font-medium">${escapeHTML(name)}</span>
                </div>
                <div class="p-3.5 rounded-xl bg-charcoal border border-white/5">
                    <span class="text-[10px] uppercase tracking-widest text-silverMuted block">Date & Time</span>
                    <span class="text-alabaster font-medium">${formattedDate} &bull; ${time}</span>
                </div>
                <div class="p-3.5 rounded-xl bg-charcoal border border-white/5">
                    <span class="text-[10px] uppercase tracking-widest text-silverMuted block">Party & Area</span>
                    <span class="text-gold font-medium">${guests} (${seating})</span>
                </div>
                <div class="sm:col-span-2 md:col-span-3 p-3.5 rounded-xl bg-charcoal border border-white/5">
                    <span class="text-[10px] uppercase tracking-widest text-silverMuted block">Special Requests</span>
                    <span class="text-silverMuted font-light">${escapeHTML(notes)}</span>
                </div>
            `;

            // Compose WhatsApp message
            formattedSummaryText = 
`Hello Cloud Lounge Jakarta (49th Floor), I would like to confirm a table reservation via cloudloungejakarta.com:

• Ref ID: #${refCode}
• Name: ${name}
• Date: ${formattedDate}
• Time: ${time}
• Guests: ${guests}
• Seating: ${seating}
• Notes: ${notes}

Thank you.`;

            const waNumber = '6281282504949';
            const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(formattedSummaryText)}`;
            document.getElementById('whatsapp-btn').href = waUrl;

            // Show confirmation panel and scroll smoothly to it
            const panel = document.getElementById('confirmation-panel');
            panel.classList.remove('hidden');
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });

        // Copy details fallback using document.execCommand('copy') for iframe compatibility
        function copyBookingText() {
            if (!formattedSummaryText) return;
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = formattedSummaryText;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            try {
                document.execCommand('copy');
                const label = document.getElementById('copy-label');
                label.textContent = 'Copied!';
                setTimeout(() => {
                    label.textContent = 'Copy Details';
                }, 2500);
            } catch (err) {
                console.error('Copy failed', err);
            }
            document.body.removeChild(tempTextArea);
        }

        // Basic XSS sanitization helper
        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag]));
        }
    </script>
</body>
</html>